//@version=5
indicator("Pupupu Pivots", overlay=true, max_lines_count=500)
lookback = input.int(100, "Lookback Periods", minval=10, maxval=500)
show_labels = input.bool(false, "Show Labels")
show_ema = input.bool(true, "Show EMA 15")
show_vwap = input.bool(true, "Show VWAP")
res_color = color.rgb(38, 166, 154)
sup_color = color.rgb(255, 82, 82)
ema_color = color.rgb(255, 235, 59)
vwap_color = color.rgb(156, 39, 176)
var line[] all_res_lines = array.new<line>()
var line[] all_sup_lines = array.new<line>()
var line current_res_line = na
var line current_sup_line = na
var label current_res_label = na
var label current_sup_label = na
var int window_start_bar = 0
var int bars_in_day = 0
if ta.change(dayofmonth) != 0
    bars_in_day := 0
    window_start_bar := bar_index
    if array.size(all_res_lines) > 0
        for i = 0 to array.size(all_res_lines) - 1
            line.delete(array.get(all_res_lines, i))
        array.clear(all_res_lines)
    if array.size(all_sup_lines) > 0
        for i = 0 to array.size(all_sup_lines) - 1
            line.delete(array.get(all_sup_lines, i))
        array.clear(all_sup_lines)
    if not na(current_res_line)
        line.delete(current_res_line)
        current_res_line := na
    if not na(current_sup_line)
        line.delete(current_sup_line)
        current_sup_line := na
    if not na(current_res_label)
        label.delete(current_res_label)
        current_res_label := na
    if not na(current_sup_label)
        label.delete(current_sup_label)
        current_sup_label := na
else
    bars_in_day += 1
window_number = bars_in_day / lookback
bars_in_window = bars_in_day % lookback
is_new_window = bars_in_window == 0 and bars_in_day > 0
if is_new_window
    if not na(current_res_line)
        array.push(all_res_lines, current_res_line)
    if not na(current_sup_line)
        array.push(all_sup_lines, current_sup_line)
    window_start_bar := bar_index
    current_res_line := na
    current_sup_line := na
    current_res_label := na
    current_sup_label := na
int lookback_bars = math.min(bars_in_window + 1, lookback)
float window_high = ta.highest(high, lookback_bars)
float window_low = ta.lowest(low, lookback_bars)
if na(current_res_line)
    current_res_line := line.new(window_start_bar, window_high, bar_index, window_high, color=res_color, width=2)
    if show_labels
        current_res_label := label.new(window_start_bar, window_high, "R" + str.tostring(window_number), color=res_color, textcolor=color.white, style=label.style_label_left, size=size.tiny)
else
    line.set_y1(current_res_line, window_high)
    line.set_y2(current_res_line, window_high)
    line.set_x2(current_res_line, bar_index)
    if show_labels and not na(current_res_label)
        label.set_y(current_res_label, window_high)
if na(current_sup_line)
    current_sup_line := line.new(window_start_bar, window_low, bar_index, window_low, color=sup_color, width=2)
    if show_labels
        current_sup_label := label.new(window_start_bar, window_low, "S" + str.tostring(window_number), color=sup_color, textcolor=color.white, style=label.style_label_right, size=size.tiny)
else
    line.set_y1(current_sup_line, window_low)
    line.set_y2(current_sup_line, window_low)
    line.set_x2(current_sup_line, bar_index)
    if show_labels and not na(current_sup_label)
        label.set_y(current_sup_label, window_low)
bgcolor(is_new_window ? color.new(color.blue, 90) : na)
ema15 = ta.ema(close, 15)
var float vwap_sum = 0.0
var float vwap_vol = 0.0
if ta.change(dayofmonth) != 0
    vwap_sum := 0.0
    vwap_vol := 0.0
vwap_sum += close * volume
vwap_vol += volume
session_vwap = vwap_sum / vwap_vol
plot(show_ema ? ema15 : na, "EMA 15", color=ema_color, linewidth=2)
plot(show_vwap ? session_vwap : na, "VWAP", color=vwap_color, linewidth=2, style=plot.style_circles)

// EMA Cross Detection (Intra-candle: Open < EMA < Close or Open > EMA > Close)
bool intra_cross_up = open < ema15 and close > ema15
bool intra_cross_down = open > ema15 and close < ema15

// Visual signals for EMA crosses
plotshape(intra_cross_up, "Long Signal", shape.triangleup, location.belowbar, color.new(color.green, 0), size=size.small)
plotshape(intra_cross_down, "Short Signal", shape.triangledown, location.abovebar, color.new(color.red, 0), size=size.small)
var table info = table.new(position.bottom_right, 2, 3, bgcolor=color.new(color.black, 80), border_width=1)
if barstate.islast
    table.cell(info, 0, 0, "Window", text_color=color.white)
    table.cell(info, 1, 0, str.tostring(window_number), text_color=color.yellow)
    table.cell(info, 0, 1, "Bar in window", text_color=color.white)
    table.cell(info, 1, 1, str.tostring(bars_in_window) + "/" + str.tostring(lookback), text_color=color.orange)
    table.cell(info, 0, 2, "Next reset", text_color=color.white)
    table.cell(info, 1, 2, str.tostring(lookback - bars_in_window) + " bars", text_color=color.green)
