# ============================================================================
# Production Environment Configuration
# ============================================================================
# IMPORTANT: Update all passwords and sensitive values before deploying!
# ============================================================================

# Database Configuration
POSTGRES_DB=stock_analyzer_prod
POSTGRES_USER=stock_analyzer_user
POSTGRES_PASSWORD=CHANGE_THIS_TO_SECURE_PASSWORD  # MUST CHANGE THIS!
POSTGRES_HOST=localhost
POSTGRES_PORT=5433  # Different port to avoid conflicts with local

# Database URL (for SQLAlchemy)
DATABASE_URL=postgresql://stock_analyzer_user:CHANGE_THIS_TO_SECURE_PASSWORD@localhost:5433/stock_analyzer_prod

# Application Environment
ENVIRONMENT=production
DEBUG=False
LOG_LEVEL=INFO

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Trading Configuration
AUTOTRADER_ENABLED=false  # Enable manually when ready
MAX_POSITIONS_STOCKS=10
MAX_POSITIONS_CRYPTO=5

# Capital Allocation
LIQUID_CAPITAL_STOCKS=10000.00
LIQUID_CAPITAL_CRYPTO=50000.00

# Trading Thresholds (from proven backtest)
BUY_SCORE_THRESHOLD=6.0
SELL_SCORE_THRESHOLD=4.5
SHORT_SCORE_THRESHOLD=1.8

# Risk Management
RISK_PER_TRADE=0.02
MAX_PORTFOLIO_RISK=0.10

# Data Collection
DATA_ACCUMULATOR_ENABLED=true
DATA_ACCUMULATOR_SCHEDULE=0 16 * * *  # Daily at 4 PM ET (after market close)

# Box Strategy Configuration
BOX_STRATEGY_ML_VERSION=1
BOX_STRATEGY_ENABLED=true

# Market Hours (ET)
MARKET_OPEN_HOUR=9
MARKET_OPEN_MINUTE=30
MARKET_CLOSE_HOUR=16
MARKET_CLOSE_MINUTE=0

# Rate Limiting (yfinance)
YFINANCE_MAX_CALLS_PER_MINUTE=60

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_KEEP_DAYS=30  # Keep 30 days in production

# Security
SECRET_KEY=CHANGE_THIS_TO_RANDOM_SECRET_KEY  # MUST CHANGE THIS!
ALLOWED_HOSTS=*  # Update with actual domain

# Optional: External Services
# POLYGON_API_KEY=your_polygon_key_if_subscribed
# IBKR_USERNAME=your_ibkr_username
# IBKR_PASSWORD=your_ibkr_password


